<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>9.0</LangVersion>
        <RootNamespace>me.tooster.sdf.AST.Generators</RootNamespace>
        <Company>me.tooster</Company>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <Authors>tooster</Authors>
        <AssemblyName>Generators</AssemblyName>
        <Product>sdf.Generators</Product>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.9.0" />
    </ItemGroup>

    <!-- Release builds refresh the analyzer DLL shipped in the Unity package (its .meta keeps the
         RoslynAnalyzer label). Override UnityPackageAstDir to build somewhere else. -->
    <PropertyGroup>
        <UnityPackageAstDir Condition="'$(UnityPackageAstDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\packages\me.tooster.sdf\Runtime\AST\</UnityPackageAstDir>
    </PropertyGroup>

    <Target Name="CopyGeneratorToUnityPackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityPackageAstDir)" />
        <Message Importance="high" Text="Copied $(TargetFileName) to $(UnityPackageAstDir)" />
    </Target>

</Project>
